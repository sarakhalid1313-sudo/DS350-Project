-- 1) SELECT STATEMENTS

SELECT Name, Cost
FROM MEDICINES
WHERE Cost > 20;


SELECT Fname, Mname, Lname, Gender
FROM PERSON
WHERE Gender = 'F';



-- 2) JOIN QUERIES

SELECT
    pat_person.Fname AS Patient_First,
    pat_person.Lname AS Patient_Last,
    a.Appt_Date,
    a.Appt_Time,
    doc_person.Fname AS Doctor_First,
    doc_person.Lname AS Doctor_Last,
    d.Specialization
FROM APPOINTMENTS a
JOIN PATIENTS pt        ON a.FileID = pt.FileID
JOIN PERSON pat_person   ON pt.PersonID = pat_person.PersonID
JOIN DOCTORS d          ON a.DoctorID = d.DoctorID
JOIN PERSON doc_person   ON d.PersonID = doc_person.PersonID;

SELECT
    t.Treat_Name,
    m.Name AS Medicine_Name,
    o.Quantity
FROM TREATMENTS t
JOIN OFFERS o     ON t.TreatID = o.TreatID
JOIN MEDICINES m  ON o.MedicineID = m.MedicineID;



-- 3) NESTED QUERIES

SELECT Fname, Lname
FROM PERSON
WHERE PersonID IN (
    SELECT PersonID
    FROM PATIENTS
    WHERE FileID IN (
        SELECT FileID
        FROM PAYMENTS
        WHERE Total > 100
    )
);


SELECT Treat_Name
FROM TREATMENTS
WHERE TreatID IN (
    SELECT TreatID
    FROM OFFERS
    WHERE MedicineID = (
        SELECT MedicineID
        FROM MEDICINES
        WHERE Name = 'Aspirin'
    )
);


