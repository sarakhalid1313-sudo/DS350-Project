-- 6) VIEW



CREATE VIEW PatientAppointmentView AS
SELECT
    p.Fname AS Patient_First,
    p.Lname AS Patient_Last,
    a.Appt_Date,
    a.Appt_Time,
    d.Specialization
FROM APPOINTMENTS a
JOIN PATIENTS pt ON a.FileID = pt.FileID
JOIN PERSON p    ON pt.PersonID = p.PersonID
JOIN DOCTORS d   ON a.DoctorID = d.DoctorID;


SELECT * FROM PatientAppointmentView;



-- 7) TRIGGER


CREATE TABLE APPOINTMENT_LOG (
    LogID INT AUTO_INCREMENT PRIMARY KEY,
    ApptID INT,
    Action_Type VARCHAR(50),
    Action_Date DATETIME DEFAULT CURRENT_TIMESTAMP
);


CREATE TRIGGER trg_after_appointment_insert
AFTER INSERT ON APPOINTMENTS
FOR EACH ROW
BEGIN
    INSERT INTO APPOINTMENT_LOG (ApptID, Action_Type)
    VALUES (NEW.ApptID, 'New appointment scheduled');
END;


