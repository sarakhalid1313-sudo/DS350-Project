1- Creating the DB: 

CREATE DATABASE SmartClinicDB;
USE SmartClinicDB;


2- Table Creation: 

-- Superclass: PERSON
CREATE TABLE PERSON (
    PersonID INT PRIMARY KEY,
    Fname VARCHAR(50) NOT NULL,
    Mname VARCHAR(50),
    Lname VARCHAR(50) NOT NULL,
    Gender CHAR(1) CHECK (Gender IN ('M', 'F'))
);

-- Multivalued Attribute: Phone
CREATE TABLE PERSON_PHONE (
    PersonID INT,
    Phone VARCHAR(15),
    PRIMARY KEY (PersonID, Phone),
    FOREIGN KEY (PersonID) REFERENCES PERSON(PersonID) ON DELETE CASCADE
);

-- Subclass: PATIENTS
CREATE TABLE PATIENTS (
    FileID INT PRIMARY KEY,
    PersonID INT UNIQUE,
    Insurance VARCHAR(100),
    FOREIGN KEY (PersonID) REFERENCES PERSON(PersonID) ON DELETE CASCADE
);

-- Subclass: DOCTORS
CREATE TABLE DOCTORS (
    DoctorID INT PRIMARY KEY,
    PersonID INT UNIQUE,
    Specialization VARCHAR(100) NOT NULL,
    FOREIGN KEY (PersonID) REFERENCES PERSON(PersonID) ON DELETE CASCADE
);

-- Entity: APPOINTMENTS (Maps 1:M ATTENDS and HAS relationships)
CREATE TABLE APPOINTMENTS (
    ApptID INT PRIMARY KEY,
    Appt_Date DATE NOT NULL,
    Appt_Time TIME NOT NULL,
    FileID INT NOT NULL,
    DoctorID INT NOT NULL,
    FOREIGN KEY (FileID) REFERENCES PATIENTS(FileID) ON DELETE CASCADE,
    FOREIGN KEY (DoctorID) REFERENCES DOCTORS(DoctorID) ON DELETE CASCADE
);

-- Entity: PAYMENTS (Maps 1:M MAKES relationship)
CREATE TABLE PAYMENTS (
    PayID INT PRIMARY KEY,
    Total DECIMAL(10, 2) NOT NULL,
    Pay_Date DATE NOT NULL,
    FileID INT NOT NULL,
    FOREIGN KEY (FileID) REFERENCES PATIENTS(FileID) ON DELETE CASCADE
);

-- Entity: TREATMENTS (Maps 1:M PROVIDES relationship)
CREATE TABLE TREATMENTS (
    TreatID INT PRIMARY KEY,
    Treat_Name VARCHAR(100) NOT NULL,
    Start_date DATE NOT NULL,
    End_date DATE,
    ApptID INT NOT NULL,
    FOREIGN KEY (ApptID) REFERENCES APPOINTMENTS(ApptID) ON DELETE CASCADE
);

-- Entity: MEDICINES
CREATE TABLE MEDICINES (
    MedicineID INT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL UNIQUE,
    Cost DECIMAL(10, 2) NOT NULL
);

-- Many-to-Many Relationship: OFFERS (Treatments & Medicines)
CREATE TABLE OFFERS (
    TreatID INT,
    MedicineID INT,
    Quantity INT NOT NULL CHECK (Quantity > 0),
    PRIMARY KEY (TreatID, MedicineID),
    FOREIGN KEY (TreatID) REFERENCES TREATMENTS(TreatID) ON DELETE CASCADE,
    FOREIGN KEY (MedicineID) REFERENCES MEDICINES(MedicineID) ON DELETE CASCADE
);




